# Dependencias instaladas localmente por npm.
node_modules/

# Variables locales y secretos.
# Nunca se deben subir al repositorio.
.env
.env.*
!.env.example

# Logs y archivos temporales de npm/yarn.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Copia local de Babel que descarga tools/verify-dashboard.js.
# Son ~2,4 MB y se vuelven a descargar solos cuando hacen falta.
tools/.cache/

# Archivos del sistema operativo.
.DS_Store
Thumbs.db
