{
  "version": 2,
  "builds": [
    {
      "src": "ado-sync.js",
      "use": "@vercel/node"
    }
  ],
   "routes": [
    {
      "src": "^/dashboard-app$",
      "dest": "/dashboard-app.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/dashboard-app.html"
    },
    {
      "src": "^/dashboard\\.html$",
      "dest": "/dashboard-app.html"
    },
    {
      "src": "/(.*)",
      "dest": "ado-sync.js"
    }
  ]
}
