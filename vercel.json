{
  "version": 2,
  "builds": [
    {
      "src": "ado-sync.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Location": "/dashboard"
      },
      "status": 307
    },
    {
      "src": "^/dashboard$",
      "headers": {
        "Location": "/dashboard-app.html"
      },
      "status": 307
    },
    {
      "src": "^/dashboard\\.html$",
      "headers": {
        "Location": "/dashboard"
      },
      "status": 307
    },
    {
      "src": "/(.*)",
      "dest": "ado-sync.js"
    }
  ]
}
