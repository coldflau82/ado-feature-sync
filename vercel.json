{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/internal/sync-feature-caches",
      "schedule": "0 5 * * *"
    }
  ],
  "builds": [
    {
      "src": "ado-sync.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "config/delivery-health-rules.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ado-sync.js"
    }
  ]
}
