{
  "version": 2,
  "builds": [
    {
      "src": "ado-sync.js",
      "use": "@vercel/node"
      "config": {
        "includeFiles": [
          "favicon.png",
          "dashboard.html",
          "filters-cards/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ado-sync.js"
    }
  ]
}
