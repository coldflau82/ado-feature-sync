{
  "version": 2,
  "builds": [
    {
      "src": "ado-sync.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ado-sync.js"
    }
  ]
  {
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ado-sync.js": {
      "includeFiles": "Config/delivery-health-rules.json"
    }
  }
}
}
